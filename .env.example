# Formulaire de contact - Formspree (https://formspree.io)
NEXT_PUBLIC_FORMSPREE_ID=

# Paiement PayPal (_xclick + IPN). Compte : contact@zen-villa.fr
# Ne pas utiliser paypal.me : pas de confirmation automatique du séjour.

# --- Espace membre (obligatoire sur Vercel) ---
DATABASE_URL=
# Secret de session : openssl rand -base64 48  (≥ 32 caractères)
OWNER_SESSION_SECRET=
OWNER_ADMIN_SECRET=
OWNER_ADMIN_EMAIL=contact@zen-villa.fr
# Mot de passe admin — uniquement en variables Vercel, jamais dans le code
OWNER_ADMIN_PASSWORD=
# Code unique d’équipe, uniquement pour créer un compte nominatif (/equipe/inscription)
STAFF_SIGNUP_CODE=
# false en production : pas de compte démo ni de séjours fictifs
OWNER_SEED_DEMO=false
# Envoi d’e-mails au propriétaire (check-in / ménage) — https://resend.com
RESEND_API_KEY=
# Ex. Zenvilla <contact@zen-villa.fr> (domaine à vérifier chez Resend)
RESEND_FROM=
