# Formulaire de contact - Formspree (https://formspree.io)
# Créez un compte gratuit, créez un formulaire, et copiez l'ID ici.
# Exemple : si votre URL Formspree est https://formspree.io/f/xyzabc, mettez xyzabc
NEXT_PUBLIC_FORMSPREE_ID=

# Lien PayPal.me (sans https) : ex. zenvilla → paypal.me/zenvilla/440EUR
# Si vide, PayPal s’ouvre avec contact@zen-villa.fr et le montant du calendrier
NEXT_PUBLIC_PAYPAL_ME=

# Paiement Stripe (plus tard)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
