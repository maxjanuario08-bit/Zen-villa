# Formulaire de contact - Formspree (https://formspree.io)
NEXT_PUBLIC_FORMSPREE_ID=

# Lien PayPal.me (sans https)
NEXT_PUBLIC_PAYPAL_ME=

# Paiement Stripe (plus tard)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Espace membre (obligatoire sur Vercel) ---
# Neon / Vercel Postgres (Storage → Create Database → copier l’URL)
DATABASE_URL=
# Secret de session : openssl rand -base64 48  (≥ 32 caractères, jamais change-me-locally)
OWNER_SESSION_SECRET=
# Secret pour lier un logement à un email après inscription
# curl -X POST https://www.zen-villa.fr/api/owner/admin/link \
#   -H "Authorization: Bearer $OWNER_ADMIN_SECRET" \
#   -H "Content-Type: application/json" \
#   -d '{"email":"proprio@mail.fr","slug":"mini-villa-pinson"}'
OWNER_ADMIN_SECRET=
# Connexion https://www.zen-villa.fr/admin (à retenir)
OWNER_ADMIN_EMAIL=contact@zen-villa.fr
OWNER_ADMIN_PASSWORD=
# Accès https://www.zen-villa.fr/equipe (personnel check-in / ménage)
# Code d’accès par défaut si vide
STAFF_PASSWORD=
# false en production : pas de compte démo ni de séjours fictifs
OWNER_SEED_DEMO=false
